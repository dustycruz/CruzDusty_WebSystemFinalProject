    {
      "name": "5. Client-data tampering",
      "item": [
        {
          "name": "5.1 POST grade 60 with a false remark CMS (server saves BEP/FAILED)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Client remark CMS was ignored', () => pm.expect(body.remarks).to.not.eql('CMS'));",
                  "pm.test('Server computed BEP/FAILED for 60', () => pm.expect(body.remarks).to.eql('BEP/FAILED'));",
                  "pm.collectionVariables.set('tamperGradeId', body.gradeId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{facultyToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentId\": {{pedroStudentId}},\n  \"subjectCode\": \"IT202\",\n  \"subjectName\": \"Information Management\",\n  \"grade\": 60,\n  \"remarks\": \"CMS\",\n  \"semester\": \"1st Semester\",\n  \"schoolYear\": \"2026-2027\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/grades"
          }
        },
        {
          "name": "5.2 PUT grade 91 with a false remark BEP/FAILED (server saves SP)",
