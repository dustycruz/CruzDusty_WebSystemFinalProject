                  "pm.test('Client remark BEP/FAILED was ignored', () => pm.expect(body.remarks).to.not.eql('BEP/FAILED'));",
                  "pm.test('Server computed SP for 91', () => pm.expect(body.remarks).to.eql('SP'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{facultyToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentId\": {{pedroStudentId}},\n  \"subjectCode\": \"IT202\",\n  \"subjectName\": \"Information Management\",\n  \"grade\": 91,\n  \"remarks\": \"BEP/FAILED\",\n  \"semester\": \"1st Semester\",\n  \"schoolYear\": \"2026-2027\"\n}",
