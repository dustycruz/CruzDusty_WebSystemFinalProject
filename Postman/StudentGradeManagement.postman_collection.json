      "name": "6. Student access and ownership",
      "item": [
        {
          "name": "6.1 Student GET own grades (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "const result = pm.response.json();",
                  "pm.test('Profile is the signed-in student', () => pm.expect(result.student.studentNumber).to.eql('2026-0001'));",
                  "pm.test('Every grade belongs to the signed-in student', () => result.grades.forEach(g => pm.expect(g.studentNumber).to.eql('2026-0001')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
