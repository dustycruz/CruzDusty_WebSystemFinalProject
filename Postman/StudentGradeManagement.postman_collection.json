{
  "info": {
    "name": "Student Grade Management System",
    "description": "Required tests for the practical examination. Run the folders in order. Turn off SSL certificate verification in Postman settings because the API uses the local development certificate.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://localhost:7001" },
    { "key": "facultyToken", "value": "" },
    { "key": "studentToken", "value": "" },
    { "key": "pedroStudentId", "value": "" },
    { "key": "otherStudentId", "value": "" },
    { "key": "otherStudentGradeId", "value": "" },
    { "key": "createdGradeId", "value": "" },
    { "key": "tamperGradeId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Sign in",
      "item": [
        {
          "name": "1.1 Faculty login (faculty1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Role is Faculty', () => pm.expect(body.role).to.eql('Faculty'));",
                  "pm.test('Token is returned', () => pm.expect(body.token).to.be.a('string').and.not.empty);",
                  "pm.collectionVariables.set('facultyToken', body.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"faculty1\",\n  \"password\": \"Faculty@123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "1.2 Student login (student1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Role is Student', () => pm.expect(body.role).to.eql('Student'));",
                  "pm.test('Linked to a student record', () => pm.expect(body.studentId).to.be.a('number'));",
                  "pm.collectionVariables.set('studentToken', body.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"student1\",\n  \"password\": \"Student@123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "1.3 Login with a wrong password (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('No token is returned', () => pm.expect(pm.response.json().token).to.be.undefined);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"student1\",\n  \"password\": \"WrongPassword1!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        }
      ]
    },
    {
      "name": "2. Setup",
      "item": [
        {
          "name": "2.1 Faculty GET students (saves ids)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "const students = pm.response.json();",
                  "const pedro = students.find(s => s.studentNumber === '2026-0003');",
                  "const maria = students.find(s => s.studentNumber === '2026-0002');",
                  "pm.test('Seed students 2026-0002 and 2026-0003 exist', () => { pm.expect(pedro).to.be.an('object'); pm.expect(maria).to.be.an('object'); });",
                  "if (pedro) { pm.collectionVariables.set('pedroStudentId', pedro.studentId); }",
                  "if (maria) { pm.collectionVariables.set('otherStudentId', maria.studentId); }"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{facultyToken}}" }
            ],
            "url": "{{baseUrl}}/api/students"
          }
        },
        {
          "name": "2.2 Remove leftovers from a previous run",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "const leftovers = pm.response.json().filter(g => ['IT201', 'IT202'].includes(g.subjectCode) && g.semester === '1st Semester' && g.schoolYear === '2026-2027');",
                  "leftovers.forEach(g => {",
                  "  pm.sendRequest({",
                  "    url: pm.collectionVariables.get('baseUrl') + '/api/grades/' + g.gradeId,",
                  "    method: 'DELETE',",
                  "    header: [{ key: 'Authorization', value: 'Bearer ' + pm.collectionVariables.get('facultyToken') }]",
                  "  }, (err, res) => pm.test('Removed leftover grade ' + g.gradeId, () => pm.expect(res.code).to.eql(204)));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{facultyToken}}" }
            ],
            "url": "{{baseUrl}}/api/grades?studentId={{pedroStudentId}}"
          }
        }
      ]
    },
    {
      "name": "3. Faculty grade management",
      "item": [
        {
          "name": "3.1 Faculty GET all grades (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "const grades = pm.response.json();",
                  "pm.test('Returns an array of grade records', () => pm.expect(grades).to.be.an('array').and.not.empty);",
                  "pm.test('Each record has student, subject, grade, remarks, semester and school year', () => {",
                  "  grades.forEach(g => pm.expect(g).to.include.keys('studentNumber', 'studentName', 'subjectCode', 'subjectName', 'grade', 'remarks', 'semester', 'schoolYear'));",
                  "});",
                  "const other = grades.find(g => g.studentNumber === '2026-0002');",
                  "if (other) { pm.collectionVariables.set('otherStudentGradeId', other.gradeId); }"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{facultyToken}}" }
            ],
            "url": "{{baseUrl}}/api/grades"
          }
        },
        {
          "name": "3.2 Faculty POST a valid grade (201, CMS)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Remark computed by the server is CMS', () => pm.expect(body.remarks).to.eql('CMS'));",
                  "pm.test('FacultyId comes from the signed-in faculty', () => pm.expect(body.facultyName).to.eql('Andrea Garcia'));",
                  "pm.test('Location header points to the new record', () => pm.expect(pm.response.headers.get('Location')).to.include('/api/grades/' + body.gradeId));",
                  "pm.collectionVariables.set('createdGradeId', body.gradeId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{facultyToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentId\": {{pedroStudentId}},\n  \"subjectCode\": \"IT201\",\n  \"subjectName\": \"Data Structures and Algorithms\",\n  \"grade\": 96,\n  \"semester\": \"1st Semester\",\n  \"schoolYear\": \"2026-2027\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/grades"
          }
        },
        {
          "name": "3.3 Faculty GET one grade (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Returns the created record', () => pm.expect(body.gradeId).to.eql(Number(pm.collectionVariables.get('createdGradeId'))));",
                  "pm.test('Grade and remark are stored', () => { pm.expect(body.grade).to.eql(96); pm.expect(body.remarks).to.eql('CMS'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{facultyToken}}" }
            ],
            "url": "{{baseUrl}}/api/grades/{{createdGradeId}}"
          }
        },
        {
          "name": "3.4 Faculty PUT changes the grade (remark becomes BEP/FAILED)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Grade updated to 74', () => pm.expect(body.grade).to.eql(74));",
                  "pm.test('Remark recomputed from CMS to BEP/FAILED', () => pm.expect(body.remarks).to.eql('BEP/FAILED'));",
                  "pm.test('DateModified is set', () => pm.expect(body.dateModified).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{facultyToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentId\": {{pedroStudentId}},\n  \"subjectCode\": \"IT201\",\n  \"subjectName\": \"Data Structures and Algorithms\",\n  \"grade\": 74,\n  \"semester\": \"1st Semester\",\n  \"schoolYear\": \"2026-2027\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/grades/{{createdGradeId}}"
          }
        }
      ]
    },
