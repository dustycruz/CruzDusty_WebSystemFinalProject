@{
    Layout = "_AppShell";
    ViewData["Title"] = "My Grades";
    ViewData["Area"] = "Student";
    ViewData["ActiveNav"] = "mygrades";
}
<div class="print-header" aria-hidden="true">
    <img src="~/images/logo.png" alt="" class="print-logo" width="72" height="72" />
    <div class="print-header-text">
        <div class="print-school">UST Angelicum College</div>
        <div class="print-system">Student Grade Management System</div>
        <div class="print-motto">Caritas &bull; Justitia &bull; Fortitudo</div>
    </div>
    <div class="print-meta">
        <div class="print-doc-title">Student Grade Report</div>
        <div>Student: <span id="print-name"></span></div>
        <div>Student No.: <span id="print-number"></span></div>
        <div>Term: <span id="print-term"></span></div>
        <div>Printed: <span id="print-date"></span></div>
    </div>
</div>

<section class="welcome-banner" aria-label="Student profile">
    <div class="welcome-avatar" id="welcome-initials" aria-hidden="true"></div>
    <div class="welcome-text">
        <p class="welcome-eyebrow">Welcome back</p>
        <h1 class="welcome-name" id="welcome-name"><span class="skeleton skeleton-text skeleton-w-50"></span></h1>
        <p class="welcome-meta">
            <span class="welcome-chip" id="welcome-number"></span>
            <span class="welcome-chip" id="welcome-email"></span>
        </p>
    </div>
    <div class="welcome-actions no-print">
        <button type="button" class="btn btn-gold" id="btn-print">
            <i class="bi bi-printer-fill me-2" aria-hidden="true"></i>Print / Save as PDF
        </button>
    </div>
</section>

<section class="row g-3 mb-4" aria-label="Grade summary">
    <div class="col-6 col-xl-3">
        <div class="stat-card stagger-item" style="--i:0">
            <div class="stat-icon stat-icon-blue" aria-hidden="true"><i class="bi bi-award-fill"></i></div>
            <div class="stat-body">
                <div class="stat-label">Average Grade</div>
                <div class="stat-value" id="sum-average"><span class="skeleton skeleton-text"></span></div>
                <div class="stat-hint" id="sum-average-hint">Of the subjects shown</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card stagger-item" style="--i:1">
            <div class="stat-icon stat-icon-success" aria-hidden="true"><i class="bi bi-check-circle-fill"></i></div>
            <div class="stat-body">
                <div class="stat-label">Subjects Passed</div>
                <div class="stat-value" id="sum-passed"><span class="skeleton skeleton-text"></span></div>
                <div class="stat-hint">Grade 75 or higher</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card stagger-item" style="--i:2">
            <div class="stat-icon stat-icon-red" aria-hidden="true"><i class="bi bi-x-circle-fill"></i></div>
            <div class="stat-body">
                <div class="stat-label">Subjects Failed</div>
                <div class="stat-value" id="sum-failed"><span class="skeleton skeleton-text"></span></div>
                <div class="stat-hint">BEP/FAILED (below 75)</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card stagger-item" style="--i:3">
            <div class="stat-icon stat-icon-gold" aria-hidden="true"><i class="bi bi-journal-bookmark-fill"></i></div>
            <div class="stat-body">
                <div class="stat-label">Total Subjects</div>
                <div class="stat-value" id="sum-total"><span class="skeleton skeleton-text"></span></div>
                <div class="stat-hint">Grades posted</div>
            </div>
        </div>
    </div>
</section>

<section class="panel" aria-labelledby="my-grades-title">
    <div class="panel-head">
        <h2 class="panel-title" id="my-grades-title">My Grades</h2>
        <span class="panel-note" id="my-grades-count" aria-live="polite"></span>
    </div>

    <ul class="term-tabs no-print" id="term-tabs" role="tablist" aria-label="Filter by school year and semester"></ul>

    <div class="grades-desktop">
        <div class="table-responsive">
            <table class="table data-table align-middle" id="my-grades-table">
                <caption class="visually-hidden">My grades</caption>
                <thead>
                    <tr>
                        <th scope="col">Subject Code</th>
                        <th scope="col">Subject</th>
                        <th scope="col" class="col-num">Grade</th>
                        <th scope="col">Remarks</th>
                        <th scope="col">Semester</th>
                        <th scope="col">School Year</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>

    <div class="grades-mobile" id="my-grades-cards"></div>

    <div class="empty-state" id="my-grades-empty" hidden>
        <img src="~/images/logo.png" alt="" class="empty-logo" width="72" height="72" />
        <p class="empty-title">No grades have been posted yet</p>
        <p class="empty-text">Your grades will appear here as soon as your faculty posts them.</p>
    </div>

    <p class="panel-footnote">
        Remarks are computed by the server: 95&ndash;100 CMS, 90&ndash;94 SP, 85&ndash;89 SAP,
        80&ndash;84 GP, 75&ndash;79 EP, 0&ndash;74 BEP/FAILED.
    </p>
</section>

@section Scripts {
    <script src="~/js/student-grades.js" asp-append-version="true"></script>
}