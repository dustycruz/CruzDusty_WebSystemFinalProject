@{
    ViewData["Title"] = "Welcome";
    ViewData["BodyClass"] = "status-body";
}
<main class="status-page" id="main-content" data-page="home">
    <div class="status-card">
        <img src="~/images/logo.png" alt="UST Angelicum College seal" class="status-logo float-gentle" width="96" height="96" />
        <h1 class="status-brand">UST Angelicum College</h1>
        <p class="status-text">Student Grade Management System</p>
        <div class="status-spinner" role="status">
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            <span>Taking you to your portal</span>
        </div>
        <noscript>
            <p class="status-text">JavaScript is required to use this portal. Please enable it and reload the page.</p>
        </noscript>
        <p class="status-foot">Caritas &bull; Justitia &bull; Fortitudo</p>
    </div>
</main>