@{
    Layout = "_AppShell";
    ViewData["Title"] = "Subjects";
    ViewData["Area"] = "Faculty";
    ViewData["ActiveNav"] = "subjects";
}
<div class="page-head">
    <div>
        <h1 class="page-title">Subjects</h1>
        <p class="page-sub">Maintain the list of subjects that grade records can be attached to.</p>
    </div>
    <div class="page-head-actions">
        <button type="button" class="btn btn-primary" id="btn-add-subject">
            <i class="bi bi-plus-lg me-2" aria-hidden="true"></i>Add Subject
        </button>
    </div>
</div>

<section class="panel" aria-label="Subject list">
    <div class="table-toolbar">
        <div class="search-box">
            <i class="bi bi-search" aria-hidden="true"></i>
            <label class="visually-hidden" for="subject-search">Search subjects by code or name</label>
            <input type="search" class="form-control" id="subject-search"
                   placeholder="Search by code or name" autocomplete="off" maxlength="60" />
        </div>
        <div class="toolbar-meta" id="subjects-count" aria-live="polite"></div>
    </div>

    <div class="table-responsive">
        <table class="table data-table align-middle" id="subjects-table">
            <caption class="visually-hidden">List of subjects</caption>
            <thead>
                <tr>
                    <th scope="col" data-sort="subjectCode">
                        <button type="button" class="th-sort">Code<i class="bi bi-arrow-down-up sort-icon" aria-hidden="true"></i></button>
                    </th>
                    <th scope="col" data-sort="subjectName">
                        <button type="button" class="th-sort">Subject Name<i class="bi bi-arrow-down-up sort-icon" aria-hidden="true"></i></button>
                    </th>
                    <th scope="col" data-sort="units" class="col-num">
                        <button type="button" class="th-sort">Units<i class="bi bi-arrow-down-up sort-icon" aria-hidden="true"></i></button>
                    </th>
                    <th scope="col">Description</th>
                    <th scope="col" class="col-actions">Actions</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>

    <div class="table-footer">
        <div class="table-info" id="subjects-info" aria-live="polite"></div>
        <nav aria-label="Subjects pagination">
            <ul class="pagination pagination-sm mb-0" id="subjects-pager"></ul>
        </nav>
    </div>
</section>

<!-- Create / Edit subject -->
<div class="modal fade" id="subject-modal" tabindex="-1" aria-labelledby="subject-modal-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content" id="subject-form" novalidate autocomplete="off">
            <div class="modal-header">
                <h2 class="modal-title" id="subject-modal-title">Add Subject</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="form-alert" id="subject-form-alert" role="alert" hidden></div>

                <div class="row g-3">
                    <div class="col-sm-7">
                        <label class="form-label" for="subject-code">Subject code <span class="req" aria-hidden="true">*</span></label>
                        <input type="text" class="form-control" id="subject-code" name="subjectCode"
                               maxlength="20" required placeholder="IT301" />
                        <div class="invalid-feedback" data-error-for="subjectCode"></div>
                    </div>
                    <div class="col-sm-5">
                        <label class="form-label" for="subject-units">Units <span class="req" aria-hidden="true">*</span></label>
                        <input type="number" class="form-control" id="subject-units" name="units"
                               min="1" max="10" step="1" required inputmode="numeric" />
                        <div class="invalid-feedback" data-error-for="units"></div>
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="subject-name">Subject name <span class="req" aria-hidden="true">*</span></label>
                        <input type="text" class="form-control" id="subject-name" name="subjectName"
                               maxlength="150" required placeholder="Systems Integration and Architecture" />
                        <div class="invalid-feedback" data-error-for="subjectName"></div>
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="subject-description">Description</label>
                        <textarea class="form-control" id="subject-description" name="description"
                                  rows="3" maxlength="500"></textarea>
                        <div class="invalid-feedback" data-error-for="description"></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-ghost" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary" id="subject-save">
                    <i class="bi bi-check2 me-2" aria-hidden="true"></i>Save Subject
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/faculty-subjects.js" asp-append-version="true"></script>
}