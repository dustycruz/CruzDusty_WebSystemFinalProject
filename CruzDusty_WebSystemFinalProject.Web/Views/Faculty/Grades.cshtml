@{
    Layout = "_AppShell";
    ViewData["Title"] = "Grade Records";
    ViewData["Area"] = "Faculty";
    ViewData["ActiveNav"] = "grades";
}
<div class="page-head">
    <div>
        <h1 class="page-title">Grade Records</h1>
        <p class="page-sub">Post, edit and delete student grades. Remarks are computed by the server from the grade.</p>
    </div>
    <div class="page-head-actions">
        <button type="button" class="btn btn-primary" id="btn-add-grade">
            <i class="bi bi-plus-lg me-2" aria-hidden="true"></i>Add Grade
        </button>
    </div>
</div>

<section class="panel filter-panel" aria-label="Filters">
    <div class="row g-3 align-items-end">
        <div class="col-12 col-sm-6 col-xl-3">
            <label class="form-label" for="filter-student">Student</label>
            <select class="form-select" id="filter-student">
                <option value="">All students</option>
            </select>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <label class="form-label" for="filter-subject">Subject</label>
            <select class="form-select" id="filter-subject">
                <option value="">All subjects</option>
            </select>
        </div>
        <div class="col-6 col-sm-4 col-xl-2">
            <label class="form-label" for="filter-semester">Semester</label>
            <select class="form-select" id="filter-semester">
                <option value="">All semesters</option>
                <option value="1st Semester">1st Semester</option>
                <option value="2nd Semester">2nd Semester</option>
                <option value="Summer">Summer</option>
            </select>
        </div>
        <div class="col-6 col-sm-4 col-xl-2">
            <label class="form-label" for="filter-school-year">School year</label>
            <select class="form-select" id="filter-school-year">
                <option value="">All years</option>
            </select>
        </div>
        <div class="col-12 col-sm-4 col-xl-2">
            <button type="button" class="btn btn-ghost w-100" id="btn-clear-filters">
                <i class="bi bi-x-circle me-2" aria-hidden="true"></i>Clear filters
            </button>
        </div>
    </div>
</section>

<section class="panel" aria-label="Grade record list">
    <div class="table-toolbar">
        <div class="search-box">
            <i class="bi bi-search" aria-hidden="true"></i>
            <label class="visually-hidden" for="grade-search">Search the listed grade records</label>
            <input type="search" class="form-control" id="grade-search"
                   placeholder="Search student, subject or remarks" autocomplete="off" maxlength="60" />
        </div>
        <div class="toolbar-meta" id="grades-count" aria-live="polite"></div>
    </div>

    <div class="table-responsive">
        <table class="table data-table align-middle" id="grades-table">
            <caption class="visually-hidden">List of grade records</caption>
            <thead>
                <tr>
                    <th scope="col" data-sort="studentName">
                        <button type="button" class="th-sort">Student<i class="bi bi-arrow-down-up sort-icon" aria-hidden="true"></i></button>
                    </th>
                    <th scope="col" data-sort="subjectCode">
                        <button type="button" class="th-sort">Subject<i class="bi bi-arrow-down-up sort-icon" aria-hidden="true"></i></button>
                    </th>
                    <th scope="col" data-sort="grade" class="col-num">
                        <button type="button" class="th-sort">Grade<i class="bi bi-arrow-down-up sort-icon" aria-hidden="true"></i></button>
                    </th>
                    <th scope="col" data-sort="remarks">
                        <button type="button" class="th-sort">Remarks<i class="bi bi-arrow-down-up sort-icon" aria-hidden="true"></i></button>
                    </th>
                    <th scope="col" data-sort="semester">
                        <button type="button" class="th-sort">Semester<i class="bi bi-arrow-down-up sort-icon" aria-hidden="true"></i></button>
                    </th>
                    <th scope="col" data-sort="schoolYear">
                        <button type="button" class="th-sort">School Year<i class="bi bi-arrow-down-up sort-icon" aria-hidden="true"></i></button>
                    </th>
                    <th scope="col" data-sort="facultyName">
                        <button type="button" class="th-sort">Posted By<i class="bi bi-arrow-down-up sort-icon" aria-hidden="true"></i></button>
                    </th>
                    <th scope="col" class="col-actions">Actions</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>

    <div class="table-footer">
        <div class="table-info" id="grades-info" aria-live="polite"></div>
        <nav aria-label="Grade records pagination">
            <ul class="pagination pagination-sm mb-0" id="grades-pager"></ul>
        </nav>
    </div>
</section>

<!-- Create / Edit grade -->
<div class="modal fade" id="grade-modal" tabindex="-1" aria-labelledby="grade-modal-title" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <form class="modal-content" id="grade-form" novalidate autocomplete="off">
            <div class="modal-header">
                <h2 class="modal-title" id="grade-modal-title">Add Grade</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="form-alert" id="grade-form-alert" role="alert" hidden></div>

                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label" for="grade-student">Student <span class="req" aria-hidden="true">*</span></label>
                        <select class="form-select" id="grade-student" name="studentId" required>
                            <option value="">Select a student</option>
                        </select>
                        <div class="invalid-feedback" data-error-for="studentId"></div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label" for="grade-subject-code">Subject code <span class="req" aria-hidden="true">*</span></label>
                        <input type="text" class="form-control" id="grade-subject-code" name="subjectCode"
                               maxlength="30" required placeholder="WEB101" list="subject-code-options"
                               autocapitalize="characters" spellcheck="false"
                               aria-describedby="grade-subject-code-help" />
                        <datalist id="subject-code-options"></datalist>
                        <div class="invalid-feedback" data-error-for="subjectCode"></div>
                        <div class="form-hint" id="grade-subject-code-help">Pick a known code to fill in the name.</div>
                    </div>
                    <div class="col-md-8">
                        <label class="form-label" for="grade-subject-name">Subject name <span class="req" aria-hidden="true">*</span></label>
                        <input type="text" class="form-control" id="grade-subject-name" name="subjectName"
                               maxlength="200" required placeholder="Web Systems and Technologies" />
                        <div class="invalid-feedback" data-error-for="subjectName"></div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label" for="grade-value">Grade <span class="req" aria-hidden="true">*</span></label>
                        <input type="number" class="form-control" id="grade-value" name="grade"
                               min="0" max="100" step="1" required inputmode="numeric"
                               aria-describedby="grade-value-help" />
                        <div class="invalid-feedback" data-error-for="grade"></div>
                        <div class="form-hint" id="grade-value-help">Whole number from 0 to 100.</div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="grade-semester">Semester <span class="req" aria-hidden="true">*</span></label>
                        <select class="form-select" id="grade-semester" name="semester" required>
                            <option value="">Select a semester</option>
                            <option value="1st Semester">1st Semester</option>
                            <option value="2nd Semester">2nd Semester</option>
                            <option value="Summer">Summer</option>
                        </select>
                        <div class="invalid-feedback" data-error-for="semester"></div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="grade-school-year">School year <span class="req" aria-hidden="true">*</span></label>
                        <input type="text" class="form-control" id="grade-school-year" name="schoolYear"
                               maxlength="9" required placeholder="2026-2027" list="school-year-options"
                               inputmode="numeric" />
                        <datalist id="school-year-options"></datalist>
                        <div class="invalid-feedback" data-error-for="schoolYear"></div>
                    </div>

                    <div class="col-12">
                        <div class="preview-box" id="grade-preview" aria-live="polite">
                            <div class="preview-label">
                                <i class="bi bi-cpu me-2" aria-hidden="true"></i>Server-computed preview
                            </div>
                            <div class="preview-grid">
                                <div class="preview-item">
                                    <span class="preview-caption">Grade</span>
                                    <span class="preview-value" id="preview-grade">--</span>
                                </div>
                                <div class="preview-item">
                                    <span class="preview-caption">Remarks</span>
                                    <span class="preview-value" id="preview-remarks">--</span>
                                </div>
                            </div>
                            <p class="preview-status" id="preview-status">
                                Enter a grade to see a preview. The saved remark is always recomputed by the server.
                            </p>
                            <p class="preview-status mt-2 mb-0">
                                Scale: 95&ndash;100 CMS &bull; 90&ndash;94 SP &bull; 85&ndash;89 SAP &bull;
                                80&ndash;84 GP &bull; 75&ndash;79 EP &bull; 0&ndash;74 BEP/FAILED
                            </p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-ghost" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary" id="grade-save">
                    <i class="bi bi-check2 me-2" aria-hidden="true"></i>Save Grade
                </button>
            </div>
        </form>
    </div>
</div>

<!-- View grade -->
<div class="modal fade" id="grade-view-modal" tabindex="-1" aria-labelledby="grade-view-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="grade-view-title">Grade Details</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <dl class="detail-list" id="grade-view-body"></dl>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-ghost" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="grade-view-edit">
                    <i class="bi bi-pencil-square me-2" aria-hidden="true"></i>Edit
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/faculty-grades.js" asp-append-version="true"></script>
}