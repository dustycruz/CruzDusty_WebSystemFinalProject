@{
    Layout = "_AppShell";
    ViewData["Title"] = "Dashboard";
    ViewData["Area"] = "Faculty";
    ViewData["ActiveNav"] = "dashboard";
}
<div class="page-head">
    <div>
        <h1 class="page-title">Faculty Dashboard</h1>
        <p class="page-sub">
            Welcome back, <span data-user-name>Faculty</span>. Here is a summary of the posted grades.
        </p>
    </div>
    <div class="page-head-actions">
        <a class="btn btn-primary" href="/Faculty/Grades">
            <i class="bi bi-journal-plus me-2" aria-hidden="true"></i>Manage Grades
        </a>
    </div>
</div>

<section class="row g-3 mb-4" aria-label="Summary">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card stagger-item" style="--i:0">
            <div class="stat-icon stat-icon-ink" aria-hidden="true"><i class="bi bi-journal-check"></i></div>
            <div class="stat-body">
                <div class="stat-label">Grade Records</div>
                <div class="stat-value" id="stat-grades"><span class="skeleton skeleton-text"></span></div>
                <div class="stat-hint">Across all terms</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card stagger-item" style="--i:1">
            <div class="stat-icon stat-icon-blue" aria-hidden="true"><i class="bi bi-people-fill"></i></div>
            <div class="stat-body">
                <div class="stat-label">Active Students</div>
                <div class="stat-value" id="stat-students"><span class="skeleton skeleton-text"></span></div>
                <div class="stat-hint">Students who can be graded</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card stagger-item" style="--i:2">
            <div class="stat-icon stat-icon-success" aria-hidden="true"><i class="bi bi-graph-up-arrow"></i></div>
            <div class="stat-body">
                <div class="stat-label">Passing Rate</div>
                <div class="stat-value" id="stat-passing"><span class="skeleton skeleton-text"></span></div>
                <div class="stat-hint" id="stat-passing-hint">Grades of 75 and above</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card stagger-item" style="--i:3">
            <div class="stat-icon stat-icon-gold" aria-hidden="true"><i class="bi bi-award-fill"></i></div>
            <div class="stat-body">
                <div class="stat-label">Average Grade</div>
                <div class="stat-value" id="stat-average"><span class="skeleton skeleton-text"></span></div>
                <div class="stat-hint">Of all posted grades</div>
            </div>
        </div>
    </div>
</section>

<div class="row g-3">
    <div class="col-12 col-lg-7">
        <section class="panel h-100" aria-labelledby="chart-title">
            <div class="panel-head">
                <h2 class="panel-title" id="chart-title">Remarks Distribution</h2>
                <span class="panel-note">Computed by the server</span>
            </div>
            <div class="panel-body">
                <div class="chart-wrap" id="chart-wrap">
                    <canvas id="remarks-chart" role="img" aria-label="Number of grade records for each remark"></canvas>
                </div>
                <ul class="chart-legend" id="chart-legend" aria-label="Remarks counts"></ul>
                <div class="empty-state" id="chart-empty" hidden>
                    <img src="~/images/logo.png" alt="" class="empty-logo" width="72" height="72" />
                    <p class="empty-title">No grades posted yet</p>
                    <p class="empty-text">Post the first grade to see the distribution.</p>
                    <a class="btn btn-primary btn-sm" href="/Faculty/Grades">
                        <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Add a grade
                    </a>
                </div>
            </div>
        </section>
    </div>

    <div class="col-12 col-lg-5">
        <section class="panel h-100" aria-labelledby="recent-title">
            <div class="panel-head">
                <h2 class="panel-title" id="recent-title">Recently Posted</h2>
                <a class="panel-link" href="/Faculty/Grades">View all</a>
            </div>
            <div class="panel-body">
                <ul class="recent-list" id="recent-grades" aria-live="polite"></ul>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
    <script src="~/js/faculty-dashboard.js" asp-append-version="true"></script>
}